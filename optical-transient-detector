<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mission Control // Optical Transient Detector</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;800&family=Orbitron:wght@600;900&family=Inter:wght@400;600&display=swap" rel="stylesheet">
  
  <style>
    :root {
      --bg-dark: #0b0e14;
      --bg-card: #121824;
      --border-color: #2a3447;
      --accent-orange: #ff5500;
      --accent-cyan: #00e5ff;
      --text-main: #e2e8f0;
      --text-muted: #64748b;
      --font-heading: 'Orbitron', sans-serif;
      --font-mono: 'JetBrains Mono', monospace;
      --font-body: 'Inter', sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      font-family: var(--font-body);
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow: hidden;
    }

    /* Top Navigation / Telemetry Bar */
    header {
      background: var(--bg-card);
      border-bottom: 1px solid var(--border-color);
      padding: 0.75rem 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .brand-logo {
      width: 12px;
      height: 12px;
      background: var(--accent-orange);
      box-shadow: 0 0 10px var(--accent-orange);
      transform: rotate(45deg);
    }

    .brand h1 {
      font-family: var(--font-heading);
      font-size: 1.1rem;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .system-status {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      display: flex;
      gap: 1.5rem;
    }

    .status-item { display: flex; align-items: center; gap: 0.5rem; }
    .indicator { width: 8px; height: 8px; border-radius: 50%; background: var(--accent-cyan); box-shadow: 0 0 8px var(--accent-cyan); }

    /* Dashboard Layout */
    main {
      display: grid;
      grid-template-columns: 280px 1fr 320px;
      flex: 1;
      overflow: hidden;
    }

    .panel {
      background: var(--bg-card);
      border-right: 1px solid var(--border-color);
      display: flex;
      flex-direction: column;
      padding: 1rem;
      gap: 1rem;
    }

    .panel-right {
      border-right: none;
      border-left: 1px solid var(--border-color);
    }

    .panel-title {
      font-family: var(--font-heading);
      font-size: 0.8rem;
      color: var(--text-muted);
      letter-spacing: 1.5px;
      text-transform: uppercase;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 0.5rem;
    }

    /* Form Controls */
    .control-group {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    label {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    input, select, button {
      background: var(--bg-dark);
      border: 1px solid var(--border-color);
      color: var(--text-main);
      padding: 0.6rem;
      border-radius: 4px;
      font-family: var(--font-mono);
      font-size: 0.85rem;
    }

    input:focus, select:focus {
      outline: none;
      border-color: var(--accent-cyan);
    }

    .btn-primary {
      background: var(--accent-orange);
      color: #000;
      font-weight: 800;
      border: none;
      cursor: pointer;
      font-family: var(--font-heading);
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-top: 0.5rem;
      transition: opacity 0.2s;
    }

    .btn-primary:hover { opacity: 0.9; }

    /* Main Viewer Area */
    .viewport {
      display: flex;
      flex-direction: column;
      background: #000;
      position: relative;
    }

    .viewport-controls {
      background: var(--bg-card);
      border-bottom: 1px solid var(--border-color);
      padding: 0.5rem 1rem;
      display: flex;
      gap: 1rem;
      align-items: center;
    }

    .toggle-btn {
      background: transparent;
      border: 1px solid var(--border-color);
      cursor: pointer;
    }

    .toggle-btn.active {
      background: var(--accent-cyan);
      color: #000;
      font-weight: bold;
      border-color: var(--accent-cyan);
    }

    .image-grid {
      flex: 1;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2px;
      background: var(--border-color);
      position: relative;
    }

    .image-grid.blink-mode {
      grid-template-columns: 1fr;
    }

    .frame-container {
      background: #05070a;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .frame-container.hidden { display: none; }

    .frame-tag {
      position: absolute;
      top: 10px;
      left: 10px;
      background: rgba(0, 0, 0, 0.75);
      border: 1px solid var(--border-color);
      padding: 0.2rem 0.5rem;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--accent-cyan);
      z-index: 10;
    }

    /* Mock Canvas Display */
    .space-canvas {
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0.85;
    }

    /* Reticle Overlay */
    .target-overlay {
      position: absolute;
      width: 40px;
      height: 40px;
      border: 1px solid var(--accent-orange);
      border-radius: 50%;
      top: 45%;
      left: 55%;
      transform: translate(-50%, -50%);
      pointer-events: none;
      box-shadow: 0 0 8px var(--accent-orange);
    }

    /* Telemetry Feed / Alerts */
    .alert-feed {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      overflow-y: auto;
    }

    .alert-card {
      background: var(--bg-dark);
      border-left: 3px solid var(--accent-orange);
      padding: 0.6rem;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .alert-card .title { color: var(--text-main); font-weight: bold; }
    .alert-card .meta { color: var(--text-muted); font-size: 0.7rem; }
  </style>
</head>
<body>

  <!-- Top Navigation -->
  <header>
    <div class="brand">
      <div class="brand-logo"></div>
      <h1>PAYLOAD // TRANSIENT DETECTOR</h1>
    </div>
    <div class="system-status">
      <div class="status-item"><div class="indicator"></div> MAST API: ONLINE</div>
      <div class="status-item"><div class="indicator" style="background:var(--accent-orange); box-shadow:0 0 8px var(--accent-orange)"></div> DIA PIPELINE: READY</div>
    </div>
  </header>

  <main>
    <!-- Left Sidebar: Controls -->
    <section class="panel">
      <div class="panel-title">Targeting Parameters</div>
      
      <div class="control-group">
        <label for="preset">Presets</label>
        <select id="preset">
          <option value="goods-s">GOODS-South Deep Field</option>
          <option value="hudf">Hubble Ultra Deep Field</option>
          <option value="smacs">SMACS 0723 Cluster</option>
        </select>
      </div>

      <div class="control-group">
        <label>Right Ascension (RA)</label>
        <input type="text" value="03:32:38.5" readonly>
      </div>

      <div class="control-group">
        <label>Declination (DEC)</label>
        <input type="text" value="-27:48:00.0" readonly>
      </div>

      <div class="panel-title" style="margin-top: 1rem;">Observation Epochs</div>

      <div class="control-group">
        <label>Reference (Hubble / Optical)</label>
        <input type="text" value="HST_ACS_F814W (2004)" readonly>
      </div>

      <div class="control-group">
        <label>Target (JWST / Infrared)</label>
        <input type="text" value="JWST_NIRCam_F200W (2022)" readonly>
      </div>

      <button class="btn-primary">Execute Subtraction</button>
    </section>

    <!-- Center Viewport -->
    <section class="viewport">
      <div class="viewport-controls">
        <label>Display Mode:</label>
        <button class="toggle-btn active" id="btn-split">Side-By-Side</button>
        <button class="toggle-btn" id="btn-blink">Blink Comparator</button>
        <button class="toggle-btn" id="btn-diff">Difference Map</button>
      </div>

      <div class="image-grid" id="grid">
        <!-- Frame A: HST -->
        <div class="frame-container" id="frame-a">
          <div class="frame-tag">HST // F814W (2004)</div>
          <svg class="space-canvas" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
            <rect width="400" height="400" fill="#030508"/>
            <circle cx="100" cy="120" r="3" fill="#ffffff" opacity="0.8"/>
            <circle cx="280" cy="80" r="5" fill="#ffffff" opacity="0.9"/>
            <circle cx="220" cy="180" r="2" fill="#ffffff" opacity="0.5"/>
            <!-- Target star (faint) -->
            <circle cx="220" cy="180" r="1.5" fill="#a0c4ff" opacity="0.4"/>
          </svg>
        </div>

        <!-- Frame B: JWST -->
        <div class="frame-container" id="frame-b">
          <div class="frame-tag">JWST // F200W (2022)</div>
          <div class="target-overlay"></div>
          <svg class="space-canvas" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
            <rect width="400" height="400" fill="#030508"/>
            <circle cx="100" cy="120" r="3" fill="#ffffff" opacity="0.8"/>
            <circle cx="280" cy="80" r="5" fill="#ffffff" opacity="0.9"/>
            <!-- Target star flared up (Transient) -->
            <circle cx="220" cy="180" r="8" fill="#ffaa00" opacity="0.9"/>
            <line x1="220" y1="165" x2="220" y2="195" stroke="#ffaa00" stroke-width="1.5"/>
            <line x1="205" y1="180" x2="235" y2="180" stroke="#ffaa00" stroke-width="1.5"/>
          </svg>
        </div>
      </div>
    </section>

    <!-- Right Sidebar: Transient Data Telemetry -->
    <section class="panel panel-right">
      <div class="panel-title">Detection Telemetry</div>
      
      <div class="alert-card">
        <span class="title">ANOMALY DETECTED [98.4%]</span>
        <span class="meta">RA: 03:32:38.52 | DEC: -27:48:01.1</span>
        <span style="color: var(--accent-orange); margin-top:0.2rem;">Flux Δ: +4.2 Mag (Infrared Excess)</span>
      </div>

      <div class="panel-title" style="margin-top: 1rem;">Candidate Classification</div>
      <div style="font-family: var(--font-mono); font-size: 0.8rem; display: flex; flex-direction: column; gap: 0.5rem;">
        <div>Supernova (Type Ia): <span style="color:var(--accent-cyan)">82%</span></div>
        <div>Tidal Disruption Event: <span style="color:var(--text-muted)">14%</span></div>
        <div>Instrument Artifact: <span style="color:var(--text-muted)">4%</span></div>
      </div>

      <div class="panel-title" style="margin-top: 1rem;">Recent Target Logs</div>
      <div class="alert-feed">
        <div class="alert-card">
          <span class="title">Candidate #10492</span>
          <span class="meta">GOODS-S | Verified Transients</span>
        </div>
        <div class="alert-card" style="border-color: var(--border-color);">
          <span class="title">Candidate #10491</span>
          <span class="meta">HUDF | High-z Variable Star</span>
        </div>
      </div>
    </section>
  </main>

  <script>
    const btnSplit = document.getElementById('btn-split');
    const btnBlink = document.getElementById('btn-blink');
    const grid = document.getElementById('grid');
    const frameA = document.getElementById('frame-a');
    const frameB = document.getElementById('frame-b');

    let blinkInterval = null;

    // Toggle View Modes
    btnSplit.addEventListener('click', () => {
      stopBlink();
      btnSplit.classList.add('active');
      btnBlink.classList.remove('active');
      grid.classList.remove('blink-mode');
      frameA.classList.remove('hidden');
      frameB.classList.remove('hidden');
    });

    btnBlink.addEventListener('click', () => {
      btnBlink.classList.add('active');
      btnSplit.classList.remove('active');
      grid.classList.add('blink-mode');
      startBlink();
    });

    function startBlink() {
      let visibleFrame = 0;
      blinkInterval = setInterval(() => {
        if (visibleFrame === 0) {
          frameA.classList.remove('hidden');
          frameB.classList.add('hidden');
          visibleFrame = 1;
        } else {
          frameA.classList.add('hidden');
          frameB.classList.remove('hidden');
          visibleFrame = 0;
        }
      }, 500); // Blink every 500ms
    }

    function stopBlink() {
      if (blinkInterval) clearInterval(blinkInterval);
    }
  </script>
</body>
</html>
